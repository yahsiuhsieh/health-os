# Google Cloud / Google Health API / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/gmail.send

# Supabase Postgres REST API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
HEALTHOS_ACCOUNT_KEY=personal

# AI provider. OpenRouter is the default for the personal MVP.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_MAX_OUTPUT_TOKENS=700

# Email via Gmail API
SUMMARY_RECIPIENT_EMAIL=
GMAIL_FROM_EMAIL=

# Runtime
HEALTHOS_TIMEZONE=America/Chicago
HEALTHOS_STRICT_DATA_TYPES=false
